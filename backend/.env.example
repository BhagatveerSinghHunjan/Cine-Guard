# ── CineGuard backend environment template ──
# Copy to backend/.env for local dev (the backend loads .env from its own
# working directory, i.e. backend/, when started with uvicorn from there).
# NEVER commit real keys. You must supply your own Gemini and Parallel
# credentials below for live AI extraction, risk reasoning, and research.
# Without keys the backend runs in clearly-labeled heuristic mode.

GEMINI_API_KEY=
PARALLEL_API_KEY=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_PARSE_ATTEMPTS=2

PARALLEL_TIMEOUT_SECONDS=20
PARALLEL_MAX_RESULTS=5
PARALLEL_MAX_RETRIES=2
PARALLEL_RETRY_BASE_SECONDS=0.5

RESEARCH_MAX_QUERIES=6

CINEGUARD_DB_PATH=
DATABASE_URL=

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── CineGuard environment template ──
# Copy to .env (root) and/or backend/.env for local dev.
# NEVER commit real keys. Secrets are never logged or returned by the API.
#
# Legend: [REQUIRED] needed for full production behavior
#         [OPTIONAL] sensible defaults built in
#         [DEV]      local-development only

# ── Gemini / Google ADK ──
# [REQUIRED for AI extraction + risk reasoning; without it the backend uses
#  deterministic local heuristics and says so in every response]
GEMINI_API_KEY=
# [OPTIONAL] Vertex AI alternative to an API key
GOOGLE_CLOUD_PROJECT=
# [OPTIONAL]
GOOGLE_CLOUD_LOCATION=us-central1
# [OPTIONAL]
GEMINI_MODEL=gemini-2.0-flash
# [OPTIONAL] per-call wall-clock timeout / output cap / parse retries
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_PARSE_ATTEMPTS=2

# ── Parallel Search (live external research) ──
# [REQUIRED for live research evidence; without it research is honestly
#  reported as not-run with zero sources — never faked]
PARALLEL_API_KEY=
# [OPTIONAL]
PARALLEL_TIMEOUT_SECONDS=20
PARALLEL_MAX_RESULTS=5
PARALLEL_MAX_RETRIES=2
PARALLEL_RETRY_BASE_SECONDS=0.5
RESEARCH_MAX_QUERIES=6

# ── Persistence ──
# [DEV] SQLite file for local runs (default: backend/data/cineguard.db).
# Set to use a custom path. Production Postgres DDL: backend/migrations/001_init.sql
CINEGUARD_DB_PATH=
# [OPTIONAL] sqlite:///path accepted; postgresql:// documented for production
DATABASE_URL=

# ── Backend ──
# [OPTIONAL]
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ── Readiness scoring (deterministic; backend-owned) ──
# [OPTIONAL] severity weights / confidence multipliers / status thresholds
READINESS_WEIGHT_CRITICAL=15.0
READINESS_WEIGHT_HIGH=5.0
READINESS_WEIGHT_MEDIUM=2.0
READINESS_WEIGHT_LOW=0.5
READINESS_READY_AT=80
READINESS_AT_RISK_AT=60
READINESS_HIGH_RISK_AT=40

# ── Frontend (public, safe to expose) ──
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
